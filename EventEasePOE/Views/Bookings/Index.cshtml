@model IEnumerable<EventEase.ViewModels.BookingViewModel>

@{
    ViewData["Title"] = "Advanced Booking Search";
    var bookings = ViewBag.Bookings as IEnumerable<EventEase.ViewModels.BookingViewModel>;
}

<h1><i class="bi bi-funnel"></i> Advanced Booking Search</h1>
<p class="text-muted">Filter bookings by event type, date range, and future availability.</p>

<!-- Advanced Filter Form -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <strong><i class="bi bi-sliders"></i> Filter Options</strong>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search (ID/Event/Customer)</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="e.g., 101 or Tech" value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Event Type</label>
                    <select name="eventTypeId" class="form-select" asp-items="ViewBag.EventTypeList">
                        <option value="">-- All Types --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label d-block">&nbsp;</label>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="availableOnly" value="true" id="availableOnly" @(ViewBag.AvailableOnly ? "checked" : "") />
                        <label class="form-check-label" for="availableOnly">Future bookings only</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <label class="form-label d-block">&nbsp;</label>
                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-search"></i> Filter</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create New Booking</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Clear Filters</a>
</div>

@if (bookings == null || !bookings.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> No bookings found matching your criteria.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Event</th>
                    <th>Event Type</th>
                    <th>Event Date</th>
                    <th>Venue</th>
                    <th>Location</th>
                    <th>Capacity</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in bookings)
                {
                    var isPast = item.StartDateTime < DateTime.Now;
                    <tr class="@(isPast ? "table-secondary" : "")">
                        <td>@item.BookingId</td>
                        <td>@(item.EventName ?? "N/A")</td>
                        <td>@(item.EventType ?? "Not Set")</td>
                        <td>@item.EventDate.ToString("yyyy-MM-dd")</td>
                        <td>@(item.VenueName ?? "N/A")</td>
                        <td>@(item.VenueLocation ?? "N/A")</td>
                        <td>@item.VenueCapacity</td>
                        <td>@item.StartDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.EndDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(item.CustomerName ?? "N/A")</td>
                        <td>
                            @if (string.Equals((string?)item.BookingStatus, "Confirmed", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (string.Equals((string?)item.BookingStatus, "Cancelled", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@(!string.IsNullOrEmpty((string?)item.BookingStatus) ? (string)item.BookingStatus : "Pending")</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-danger">Cancel</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
