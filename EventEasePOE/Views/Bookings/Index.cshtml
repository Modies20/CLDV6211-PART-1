@model IEnumerable<EventEase.ViewModels.BookingViewModel>

@{
    ViewData["Title"] = "Bookings - Consolidated View";
}

<h1><i class="bi bi-calendar-check"></i> Booking Management</h1>

<!-- Search Form -->
<div class="row mb-4">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="input-group">
            <input type="text" name="searchTerm" class="form-control"
                   placeholder="Search by Booking ID, Event Name, Customer..."
                   value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-success">+ New Booking</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No bookings found @(!string.IsNullOrEmpty(ViewBag.SearchTerm) ? $"matching '{ViewBag.SearchTerm}'" : "").
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Event Name</th>
                    <th>Event Date</th>
                    <th>Venue</th>
                    <th>Location</th>
                    <th>Capacity</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isPast = item.StartDateTime < DateTime.Now;
                    <tr class="@(isPast ? "table-secondary" : "")">
                        <td>@item.BookingId</td>
                        <td>@item.EventName</td>
                        <td>@item.EventDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.VenueName</td>
                        <td>@item.VenueLocation</td>
                        <td>@item.VenueCapacity</td>
                        <td>@item.StartDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.EndDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.CustomerName</td>
                        <td>
                            @if (item.BookingStatus == "Confirmed")
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (item.BookingStatus == "Cancelled")
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else if (item.BookingStatus == "Completed")
                            {
                                <span class="badge bg-secondary">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@item.BookingStatus</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-danger">Cancel</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}