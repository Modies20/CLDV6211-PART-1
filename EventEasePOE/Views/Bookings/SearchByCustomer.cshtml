@model IEnumerable<EventEase.ViewModels.BookingViewModel>?
@{
    ViewData["Title"] = "Search Bookings by Customer";
    var results = Model ?? Enumerable.Empty<EventEase.ViewModels.BookingViewModel>();
}

<h1><i class="bi bi-search"></i> Search Bookings by Customer</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <form asp-action="MyBookings" method="get" class="input-group">
            <input type="text" name="searchName" class="form-control" placeholder="Enter customer name..." value="@ViewBag.SearchName" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
            <a asp-action="MyBookings" class="btn btn-secondary">Clear</a>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty((string?)ViewBag.SearchName))
{
    <p>Showing results for: <strong>@ViewBag.SearchName</strong> (@results.Count() found)</p>
}

@if (!results.Any())
{
    <div class="alert alert-warning">No bookings found for "@ViewBag.SearchName"</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Event</th>
                    <th>Venue</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in results)
                {
                    <tr>
                        <td>@item.BookingId</td>
                        <td>@item.EventName</td>
                        <td>@item.VenueName</td>
                        <td>@item.StartDateTime.ToString("MMM dd, yyyy")</td>
                        <td>@item.EndDateTime.ToString("MMM dd, yyyy")</td>
                        <td>@item.CustomerName</td>
                        <td>
                            @if (item.BookingStatus == "Confirmed")
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (item.BookingStatus == "Cancelled")
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@item.BookingStatus</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-info">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
