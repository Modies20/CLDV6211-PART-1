@{
    ViewData["Title"] = "Upcoming Bookings";
    var bookings = ViewBag.Bookings as IEnumerable<EventEase.ViewModels.BookingViewModel>;
}

<h1><i class="bi bi-calendar-week"></i> Upcoming Bookings</h1>
<p class="text-muted">Showing @(bookings?.Count() ?? 0) upcoming bookings (start date > today)</p>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Create New Booking</a>
    <a asp-action="Index" class="btn btn-secondary">All Bookings</a>
</p>

@if (bookings == null || !bookings.Any())
{
    <div class="alert alert-success text-center">
        <h4>No upcoming bookings</h4>
        <p>All clear! No future events scheduled.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-success">
                <tr>
                    <th>Booking ID</th>
                    <th>Event</th>
                    <th>Venue</th>
                    <th>Start Date/Time</th>
                    <th>End Date/Time</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in bookings)
                {
                    <tr>
                        <td>@item.BookingId</td>
                        <td>@item.EventName</td>
                        <td>@item.VenueName</td>
                        <td>@item.StartDateTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>@item.EndDateTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>@item.CustomerName</td>
                        <td>
                            @if (item.BookingStatus == "Confirmed")
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (item.BookingStatus == "Cancelled")
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@item.BookingStatus</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-info">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
